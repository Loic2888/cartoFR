# Copy to .env and fill in. Never commit .env.

# INPI (API RNE + FTP stock)
INPI_USERNAME=
INPI_PASSWORD=
INPI_FTP_HOST=
INPI_FTP_USERNAME=
INPI_FTP_PASSWORD=

# Cargo workspace API key (MCP)
CARGO_API_KEY=

# INSEE : clé de l'API Sirene, pour la synchro SIRENE du worker (nom proposé, T008)
INSEE_API_KEY=

# Base de l'app (Postgres de Supabase) pour le worker : rôle service, contourne RLS (T006)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Les variables ci-dessous vont dans infra/.env (lu par infra/docker-compose.yml),
# pas dans ce fichier. `bash infra/generer-secrets.sh` le crée tout seul.
# ---------------------------------------------------------------------------

# Adresse publique : nom de domaine servi par Caddy, et URL de l'app
DOMAINE=
SITE_URL=
API_EXTERNAL_URL=
ADDITIONAL_REDIRECT_URLS=

# Ports de l'hôte (facultatifs : 80, 443, 3001 et 8025 par défaut)
HTTP_PORT=
HTTPS_PORT=
STUDIO_PORT=
MAILPIT_PORT=

# Supabase : mot de passe de la base, secret JWT, clés anon et service_role
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=
ANON_KEY=
SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=

# Clé HMAC des empreintes de familles exclues des réglages (garde-fou 6) : jamais de nom de famille en clair
CARTOFR_CLE_EMPREINTE=

# SMTP des liens magiques : Brevo en production, mailpit en local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=

# ---------------------------------------------------------------------------
# Interface Next.js (web/). Dans Docker, infra/docker-compose.yml les remplit
# depuis infra/.env : rien à saisir. Pour `npm --prefix web run dev` hors
# Docker, les mettre dans web/.env.local (hors git). Lues à l'exécution, côté
# serveur : aucune NEXT_PUBLIC_ (T009).
# ---------------------------------------------------------------------------

# URL de Supabase vue par le serveur Next (http://kong:8000 dans Docker)
SUPABASE_URL=
# URL publique de Supabase, pour un client navigateur (= API_EXTERNAL_URL)
SUPABASE_PUBLIC_URL=
# Clé anon (= ANON_KEY)
SUPABASE_ANON_KEY=
# Clé service_role (= SERVICE_ROLE_KEY) : invitations. Serveur seulement, jamais au navigateur
SUPABASE_SERVICE_ROLE_KEY=
# Route interne de recherche du registre (http://recherche:8080 dans Docker ;
# hors Docker : `CARTOFR_DATA=data .venv/bin/python -m cartofr.api_recherche --port 8090`
# puis http://127.0.0.1:8090). Serveur seulement (T019)
RECHERCHE_URL=
# (CARTOFR_CLE_EMPREINTE, plus haut, est aussi lue par web pour les réglages, T020)

# ---------------------------------------------------------------------------
# Worker (worker/). Dans Docker, infra/docker-compose.yml les remplit : rien à
# saisir. Hors Docker, à exporter avant `python -m cartofr` ou la recherche.
# ---------------------------------------------------------------------------

# Dossier des données (registre.duckdb, stocks) ; `data` par défaut
CARTOFR_DATA=
# Chemin du registre, s'il n'est pas <CARTOFR_DATA>/registre.duckdb (facultatif)
CARTOFR_REGISTRE=
# Adresse et port d'écoute de la route de recherche (0.0.0.0 et 8080 par défaut)
CARTOFR_RECHERCHE_HOTE=
CARTOFR_RECHERCHE_PORT=
# Niveau des journaux du worker (INFO par défaut)
CARTOFR_LOG=
# Heure de la synchro de nuit (HH:MM, ex. 02:00) ; vide = aucune synchro de nuit (T013)
CARTOFR_SYNCHRO_HEURE=
# Nombre de jours de retard rattrapés au plus par la synchro de nuit (7 dans Docker)
CARTOFR_SYNCHRO_JOURS_MAX=
# Décalage en jours du dernier jour lu par la synchro (2 = jusqu'à J-2, pour les publications tardives)
CARTOFR_SYNCHRO_DECALAGE=
# Clé OpenRouter : proposition des réglages par l'IA (T025, T037, P2).
# Lue par le worker depuis le .env de la racine. Seules des données de sociétés partent (R5)
OPENROUTER_API_KEY=
# Modèle de l'IA, nom OpenRouter ; anthropic/claude-sonnet-5.5 par défaut (facultatif)
CARTOFR_MODELE_IA=
