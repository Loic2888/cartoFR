# Copy to .env and fill in. Never commit .env.

# INPI (API RNE + FTP stock)
INPI_USERNAME=
INPI_PASSWORD=
INPI_FTP_HOST=
INPI_FTP_USERNAME=
INPI_FTP_PASSWORD=

# Cargo workspace API key (MCP)
CARGO_API_KEY=

# INSEE : clé de l'API Sirene, pour la synchro SIRENE du worker (nom proposé, T008)
INSEE_API_KEY=

# Base de l'app (Postgres de Supabase) pour le worker : rôle service, contourne RLS (T006)
DATABASE_URL=

# ---------------------------------------------------------------------------
# Les variables ci-dessous vont dans infra/.env (lu par infra/docker-compose.yml),
# pas dans ce fichier. `bash infra/generer-secrets.sh` le crée tout seul.
# ---------------------------------------------------------------------------

# Adresse publique : nom de domaine servi par Caddy, et URL de l'app
DOMAINE=
SITE_URL=
API_EXTERNAL_URL=
ADDITIONAL_REDIRECT_URLS=

# Ports de l'hôte (facultatifs : 80, 443 et 3001 par défaut)
HTTP_PORT=
HTTPS_PORT=
STUDIO_PORT=

# Supabase : mot de passe de la base, secret JWT, clés anon et service_role
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=
ANON_KEY=
SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=

# SMTP des liens magiques : Brevo en production, mailpit en local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=
